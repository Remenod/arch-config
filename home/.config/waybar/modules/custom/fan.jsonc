{
    "custom/fan": {
	"exec": "~/.config/waybar/scripts/fan.sh",
	"return-type": "json",
	// A daemon paced by isw, see the script; no "interval" or "signal".
	"restart-interval": 5,
        "format": "{text}",
        "min-length": 8,
        "max-length": 8,
	"on-click": "alacritty --class alacritty-popup-menu -e ~/.config/waybar/scripts/fan-menu.sh",
	"on-click-right": "~/.config/shared/scripts/msi-ec.sh toggle-boost",
	"tooltip": true
    }
}
