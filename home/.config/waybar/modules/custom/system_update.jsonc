{
	"custom/system_update": {
		// Continuous module: the script stays alive and prints one JSON line
		// per state change, which is what makes the fetching animation work.
		// Do NOT add "interval" here - that would turn it back into a
		// one-shot exec and kill the spinner.
		"exec": "~/.config/waybar/scripts/system-update.sh module",
		// "exec-if":
		// "hide-empty-text":
		"return-type": "json",
		"restart-interval": 5,
		"format": "{}",
		// "format-icons":
		// "rotate":
		// "align":
		// "justify":
		"min-length": 2,
		"max-length": 2,
		// The script picks the action: an upgrade normally, a reboot prompt
		// once a kernel upgrade has made a restart necessary. It spawns its
		// own terminal, so none is wrapped around it here.
		"on-click": "~/.config/waybar/scripts/system-update.sh click",
		"on-click-middle": "alacritty -e ~/.config/waybar/scripts/system-update.sh list",
		"on-click-right": "~/.config/waybar/scripts/system-update.sh refresh"
		// "on-update":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		// "tooltip-format":
		// "escape":
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
