{
	"network": {
		// "interface":
		// "rfkill":
		"interval": 10,
		// "family":
		"format": "󰤨",
		"format-ethernet": "󰈀",
		"format-wifi": "{icon}",
		// "format-linked":
		"format-disconnected": "󰤯",
		"format-disabled": "󰤮",
		// "format-alt":
		"format-icons": [
			"󰤟", "󰤢", "󰤥", "󰤨"
		],
		// "rotate":
		"min-length": 2,
		"max-length": 2,
		// "align":
		// "justify":
		"on-click": "alacritty --class alacritty-connect-menu -e ~/.config/waybar/scripts/network.sh",
		// "on-click-middle":
		"on-click-right": "~/.config/waybar/scripts/network.sh toggle",
		// "on-update":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "<b>Gateway</b>: {gwaddr}\n<span alpha='55%'>click: networks · right-click: Wi-Fi on/off</span>",
		"tooltip-format-ethernet": "<b>Interface</b>: {ifname}\n<span alpha='55%'>click: networks · right-click: Wi-Fi on/off</span>",
		"tooltip-format-wifi": "<b>Network</b>: {essid}\n<b>IP Addr</b>: {ipaddr}/{cidr}\n<b>Strength</b>: {signalStrength}%\n<b>Frequency</b>: {frequency} GHz\n<span alpha='55%'>click: networks · right-click: Wi-Fi on/off</span>",
		"tooltip-format-disconnected": "Wi-Fi Disconnected\n<span alpha='55%'>click: networks · right-click: Wi-Fi on/off</span>",
		"tooltip-format-disabled": "Wi-Fi Disabled\n<span alpha='55%'>click: networks · right-click: Wi-Fi on/off</span>"
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
