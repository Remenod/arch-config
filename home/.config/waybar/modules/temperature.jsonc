{
	// Custom module instead of Waybar's built-in "temperature" so the shown
	// sensor can be switched at runtime. Sensors are discovered from hwmon,
	// see ~/.config/waybar/scripts/temperature.sh.
	"custom/temperature": {
		"exec": "~/.config/waybar/scripts/temperature.sh module",
		"return-type": "json",
		"interval": 2,
		"signal": 3,
		"format": "{}",
		// "rotate":
		"min-length": 8,
		"max-length": 8,
		// "align":
		// "justify":
		"on-click": "alacritty --class alacritty-popup-menu -e ~/.config/waybar/scripts/temperature.sh menu",
		// "on-click-middle":
		"on-click-right": "~/.config/waybar/scripts/temperature.sh next",
		"on-scroll-up": "~/.config/waybar/scripts/temperature.sh next",
		"on-scroll-down": "~/.config/waybar/scripts/temperature.sh prev",
		"smooth-scrolling-threshold": 1
		// "tooltip":
		// "tooltip-format":
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
