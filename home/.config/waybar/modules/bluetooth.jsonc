{
	"bluetooth": {
		// "controller":
		// "format-device-preference":
		"format": "󰂯",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-on": "󰂰",
		"format-connected": "󰂱",
		// "format-connected-battery":
		// "format-no-controller":
		// "format-icons":
		// "rotate":
		"min-length": 2,
		"max-length": 2,
		// "align":
		// "justify":
		"on-click": "alacritty --class alacritty-connect-menu -e ~/.config/waybar/scripts/bluetooth.sh",
		// "on-click-middle":
		"on-click-right": "~/.config/waybar/scripts/bluetooth.sh toggle",
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "Device Addr: {device_address}\n<span alpha='55%'>click: devices · right-click: Bluetooth on/off</span>",
		"tooltip-format-disabled": "Bluetooth Disabled\n<span alpha='55%'>click: devices · right-click: Bluetooth on/off</span>",
		"tooltip-format-off": "Bluetooth Off\n<span alpha='55%'>click: devices · right-click: Bluetooth on/off</span>",
		"tooltip-format-on": "No device connected\n<span alpha='55%'>click: devices · right-click: Bluetooth on/off</span>",
		// Every connected device, with battery where the device reports it.
		"tooltip-format-connected": "{device_enumerate}\n<span alpha='55%'>click: devices · right-click: Bluetooth on/off</span>",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%"
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	}
}
